{
  "name": "@fblg/core-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "fblg headless ui",
  "exports": {
    ".": "./lib/index.tsx",
    "./styles.css": "./lib/index.css",
    "./theme.css": "./lib/theme.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "storybook:generate": "storybook-generate",
    "storybook": "storybook-generate",
    "storybook:web": "storybook dev -p 6006 -c .storybook-web"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.85.3",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@fblg/eslint-config": "workspace:*",
    "@fblg/typescript-config": "workspace:*",
    "@storybook/addon-ondevice-actions": "catalog:",
    "@storybook/addon-ondevice-controls": "catalog:",
    "@storybook/react-native": "catalog:",
    "@storybook/react-vite": "catalog:",
    "react-dom": "catalog:",
    "react-native-web": "^0.19.13",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "eslint": "^9.39.1",
    "nativewind": "^4",
    "storybook": "catalog:",
    "tailwindcss": "^3",
    "typescript": "^5.8.3",
    "vite": "catalog:",
    "@vitejs/plugin-react": "catalog:"
  }
}
