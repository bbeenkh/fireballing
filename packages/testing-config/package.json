{
  "name": "@fblg/testing-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets/react": {
      "types": "./dist/presets/react.d.ts",
      "default": "./dist/presets/react.js"
    },
    "./presets/node": {
      "types": "./dist/presets/node.d.ts",
      "default": "./dist/presets/node.js"
    },
    "./setup/jest-dom": {
      "types": "./dist/setup/jest-dom.d.ts",
      "default": "./dist/setup/jest-dom.js"
    },
    "./setup/radix-polyfill": {
      "types": "./dist/setup/radix-polyfill.d.ts",
      "default": "./dist/setup/radix-polyfill.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@fblg/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "*",
    "@vitejs/plugin-react": "*",
    "msw": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
