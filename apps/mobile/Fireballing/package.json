    "@react-native/typescript-config": "0.85.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/detox": "^18.1.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
