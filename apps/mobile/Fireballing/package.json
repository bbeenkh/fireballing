{
  "name": "fblg-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "ENVFILE=.env.development react-native run-android",
    "android:apk": "ENVFILE=.env.production sh -c 'cd android && ./gradlew assembleRelease' && open android/app/build/outputs/apk/release",
    "ios": "react-native run-ios",
    "ios:prod": "ENVFILE=.env.production react-native run-ios",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:e2e": "detox test --configuration android.emu.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "build:e2e": "detox build --configuration android.emu.debug",
    "build:e2e:ios": "detox build --configuration ios.sim.debug"
  },
  "dependencies": {
    "@fblg/authmanager": "workspace:^",
    "@fblg/core-ui": "workspace:^",
    "@fblg/schemas": "workspace:^",
    "@fblg/types": "workspace:^",
    "@fblg/utils": "workspace:^",
    "@gorhom/bottom-sheet": "^5",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/new-app-screen": "0.85.3",
