    "@react-navigation/native-stack": "^7.14.4",
    "@revopush/react-native-code-push": "^2.6.2",
    "@sentry/react-native": "^8.27.0",
    "@tanstack/react-query": "^5.22.2",
    "axios": "^1.15.2",
    "immer": "^11.1.4",
    "nativewind": "^4",
    "react": "19.2.3",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.85.3",
    "react-native-bootsplash": "^7.3.2",
    "react-native-chart-kit": "^7.0.4",
    "react-native-config": "^1.6.1",
