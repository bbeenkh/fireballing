{
  "name": "fblg-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "local": "tsx watch --env-file=.env.development src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fblg/schemas": "workspace:^",
    "@fblg/types": "workspace:^",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@supabase/supabase-js": "^2.108.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fblg/testing-config": "workspace:*",
    "@nestjs/testing": "^11.1.3",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
